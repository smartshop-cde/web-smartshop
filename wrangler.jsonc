{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smartshop",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SUPABASE_URL": "https://ujydiaksthrjgvkffego.supabase.co"
  },
  "secrets": {
    "required": ["SUPABASE_SERVICE_ROLE_KEY"]
  },
  "ai": {
    "binding": "AI"
  }
}
